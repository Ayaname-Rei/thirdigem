---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  pageTitle: string;
  heading: string;
}

const { pageTitle, heading } = Astro.props;
---

<BaseLayout title={`iGEM 2026 - ${pageTitle}`}>
  <section style="padding-top: 140px; min-height: 70vh;">
    <h1>{heading}</h1>
    <p>
      <slot />
    </p>
  </section>
</BaseLayout>
